---
const currentYear = new Date().getFullYear();
---

<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer-content">
      <div class="footer-brand">
        <div class="footer-brand-header">
          <img src="/images/pulse-icon.png" alt="Pulse Logo" width="28" height="28" />
          <span>Pulse</span>
        </div>
        <p>Native macOS client and lightweight Go agent for monitoring Linux servers, Docker containers, and systemd units.</p>
      </div>

      <div class="footer-links-group">
        <div class="footer-col">
          <h4>Product</h4>
          <ul>
            <li><a href="/#features">Core Features</a></li>
            <li><a href="/#architecture">Architecture</a></li>
            <li><a href="/#setup">One-Line Setup</a></li>
            <li><a href="/downloads">Download macOS & Linux</a></li>
            <li><a href="/changelog">Changelog & Releases</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4>Open Source</h4>
          <ul>
            <li><a href="https://github.com/miftahganzz/Pulse" target="_blank" rel="noopener noreferrer">GitHub Repository</a></li>
            <li><a href="https://github.com/miftahganzz/Pulse/releases" target="_blank" rel="noopener noreferrer">All Releases</a></li>
            <li><a href="https://github.com/miftahganzz/Pulse/issues" target="_blank" rel="noopener noreferrer">Issue Tracker</a></li>
            <li><a href="https://raw.githubusercontent.com/miftahganzz/Pulse/main/appcast.xml" target="_blank" rel="noopener noreferrer">Sparkle Appcast XML</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4>Legal & Safety</h4>
          <ul>
            <li><a href="/privacy">Privacy Policy</a></li>
            <li><a href="/terms">Terms of Service</a></li>
            <li><a href="https://github.com/miftahganzz/Pulse/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">MIT License</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} Pulse. Open source under the MIT License. Zero telemetry, local-first.</p>
      <p>Domain: <a href="https://pulse.l.cd" style="color: var(--accent);">pulse.l.cd</a></p>
    </div>
  </div>
</footer>
