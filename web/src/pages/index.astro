---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Pulse — Native macOS Server & Container Monitor"
  description="Native macOS menu bar and desktop app paired with a lightweight 7MB Go agent to monitor Linux servers, Docker containers, and systemd units with zero cloud intermediaries."
>
  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="hero-pill">
        <span class="hero-pill-dot" aria-hidden="true"></span>
        <span>Pulse v1.0.5 Released • Apple Silicon & Intel Universal</span>
      </div>

      <h1 class="hero-title">
        Monitor Linux servers & containers.<br />
        Right from your Mac menu bar.
      </h1>

      <p class="hero-subtitle">
        Point-to-point TLS. Real-time CPU, memory, disk, network, Docker container control, and systemd units. Zero third-party cloud brokers or telemetry.
      </p>

      <div class="hero-actions">
        <a href="/downloads" class="btn btn-primary">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.61-.75 1.04-1.8 1.01-2.87-.96.04-2.13.65-2.79 1.43-.58.67-1.1 1.76-1.02 2.81 1.07.08 2.19-.61 2.8-1.37z"/>
          </svg>
          <span>Download for macOS</span>
        </a>

        <a href="https://github.com/miftahganzz/Pulse" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          <span>GitHub</span>
        </a>
      </div>

      <div class="quick-install-box">
        <div class="quick-install-label">
          <span class="cmd-prefix"># Linux Agent 1-Line Install:</span>
          <code>curl -fsSL https://raw.githubusercontent.com/miftahganzz/Pulse/main/agent/pulse-agent/scripts/install.sh | sudo bash</code>
        </div>
        <button 
          type="button" 
          class="btn-copy" 
          onclick="window.copySnippet('curl -fsSL https://raw.githubusercontent.com/miftahganzz/Pulse/main/agent/pulse-agent/scripts/install.sh | sudo bash', this)"
          aria-label="Copy installation command"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span>Copy</span>
        </button>
      </div>

      <!-- App Showcase Preview Window -->
      <div class="showcase-container">
        <div class="showcase-window">
          <div class="window-header">
            <div class="window-dots" aria-hidden="true">
              <span class="window-dot dot-red"></span>
              <span class="window-dot dot-yellow"></span>
              <span class="window-dot dot-green"></span>
            </div>
            <div class="window-tabs" role="tablist">
              <button type="button" class="window-tab-btn active" data-target="screen-dashboard" role="tab" aria-selected="true">
                <span>Dashboard Overview</span>
              </button>
              <button type="button" class="window-tab-btn" data-target="screen-security" role="tab" aria-selected="false">
                <span>Port & Security Auditor</span>
              </button>
              <button type="button" class="window-tab-btn" data-target="screen-welcome" role="tab" aria-selected="false">
                <span>Zero-Trust Pairing</span>
              </button>
            </div>
          </div>

          <div class="showcase-screen">
            <img id="screen-dashboard" src="/images/pulse-dashboard.png" alt="Pulse Native macOS Dashboard displaying live system telemetry, CPU, Memory, Disk, and Docker containers" />
            <img id="screen-security" class="hidden" src="/images/pulse-security-inspector.png" alt="Pulse Security Inspector displaying open listening sockets, binding addresses, and firewall status" />
            <img id="screen-welcome" class="hidden" src="/images/pulse-welcome.png" alt="Pulse Pairing Setup screen with 6-character XXX-XXX code verification and connection options" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Features Section -->
  <section class="section" id="features">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Core Capabilities</span>
        <h2>Everything you need for Linux infrastructure. In one native window.</h2>
        <p>No heavy web dashboards, no sluggish Electron wrappers. Pulse runs as a lightweight Swift binary on macOS connected directly to a Go agent.</p>
      </div>

      <div class="grid-3">
        <!-- Feature 1 -->
        <div class="card">
          <div class="card-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
            </svg>
          </div>
          <h3 class="card-title">Live System Telemetry</h3>
          <p class="card-desc">WebSocket streaming updates every second for CPU load, memory distribution, disk partitions, and network I/O with historical sparkline graphs.</p>
        </div>

        <!-- Feature 2 -->
        <div class="card">
          <div class="card-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
              <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
          </div>
          <h3 class="card-title">Docker Container Control</h3>
          <p class="card-desc">Inspect container states, memory footprints, port mappings, and restart or stop containers. Stream live container logs (⌘L) with search filters.</p>
        </div>

        <!-- Feature 3 -->
        <div class="card">
          <div class="card-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
              <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
              <line x1="6" y1="6" x2="6.01" y2="6"></line>
              <line x1="6" y1="18" x2="6.01" y2="18"></line>
            </svg>
          </div>
          <h3 class="card-title">Systemd Unit Management</h3>
          <p class="card-desc">Monitor background services (Nginx, PostgreSQL, Caddy, custom services). Inspect journalctl logs, reload configurations, or restart failed daemons.</p>
        </div>

        <!-- Feature 4 -->
        <div class="card">
          <div class="card-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3 class="card-title">Port & Security Auditor</h3>
          <p class="card-desc">Real-time socket scanner detects open ports, warns against public 0.0.0.0 bindings for databases, and audits UFW / firewalld rules.</p>
        </div>

        <!-- Feature 5 -->
        <div class="card">
          <div class="card-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <h3 class="card-title">Zero Cloud Broker</h3>
          <p class="card-desc">Direct point-to-point TLS. Compatible with Tailscale mesh networks and Cloudflare Tunnels for secure connections with zero inbound ports open.</p>
        </div>

        <!-- Feature 6 -->
        <div class="card">
          <div class="card-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          </div>
          <h3 class="card-title">Automated Runbooks & Cleaner</h3>
          <p class="card-desc">1-click maintenance commands (⌘R) for journal logs vacuuming, Docker image pruning, DNS cache flushes, and disk space reclamation (⌘U).</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Setup Section -->
  <section class="section" id="setup">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Quick Deployment</span>
        <h2>One-line installation. Choose your network topology.</h2>
        <p>Supports Debian, Ubuntu, RHEL, CentOS, Fedora, Arch, Alpine, openSUSE, and any systemd Linux. Available in both root and non-root user mode.</p>
      </div>

      <div class="setup-tabs" role="tablist">
        <button type="button" class="tab-btn active" data-tab="tab-direct" role="tab" aria-selected="true">
          <span>Direct IP / LAN</span>
        </button>
        <button type="button" class="tab-btn" data-tab="tab-tailscale" role="tab" aria-selected="false">
          <span>Tailscale (Zero Open Ports)</span>
        </button>
        <button type="button" class="tab-btn" data-tab="tab-cloudflare" role="tab" aria-selected="false">
          <span>Cloudflare Tunnel (Zero Open Ports)</span>
        </button>
      </div>

      <!-- Tab 1: Direct IP -->
      <div class="tab-content active" id="tab-direct" role="tabpanel">
        <div class="code-snippet-box">
          <code>curl -fsSL https://raw.githubusercontent.com/miftahganzz/Pulse/main/agent/pulse-agent/scripts/install.sh | sudo bash</code>
          <button 
            type="button" 
            class="btn-copy" 
            onclick="window.copySnippet('curl -fsSL https://raw.githubusercontent.com/miftahganzz/Pulse/main/agent/pulse-agent/scripts/install.sh | sudo bash', this)"
            aria-label="Copy Direct IP install command"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <span>Copy</span>
          </button>
        </div>
        <div class="step-list">
          <div class="step-item">Downloads static Go binary matching your architecture (x86_64 or arm64).</div>
          <div class="step-item">Generates self-signed TLS certificates and registers <code>pulse-agent.service</code>.</div>
          <div class="step-item">Detects and configures firewall (UFW, firewalld, iptables) for port 9876 automatically.</div>
          <div class="step-item">Generates a temporary 6-digit pairing code (<code>XXX-XXX</code>) valid for 10 minutes.</div>
        </div>
      </div>

      <!-- Tab 2: Tailscale -->
      <div class="tab-content" id="tab-tailscale" role="tabpanel">
        <div class="code-snippet-box">
          <code>curl -fsSL https://raw.githubusercontent.com/miftahganzz/Pulse/main/agent/pulse-agent/scripts/setup-tailscale.sh | sudo bash</code>
          <button 
            type="button" 
            class="btn-copy" 
            onclick="window.copySnippet('curl -fsSL https://raw.githubusercontent.com/miftahganzz/Pulse/main/agent/pulse-agent/scripts/setup-tailscale.sh | sudo bash', this)"
            aria-label="Copy Tailscale install command"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <span>Copy</span>
          </button>
        </div>
        <div class="step-list">
          <div class="step-item">Binds Pulse exclusively to your node's Tailscale interface (<code>100.x.y.z</code>).</div>
          <div class="step-item">No public ports are opened. Accessible only by devices within your Tailnet.</div>
          <div class="step-item">WireGuard end-to-end encryption with seamless roaming across networks.</div>
        </div>
      </div>

      <!-- Tab 3: Cloudflare Tunnel -->
      <div class="tab-content" id="tab-cloudflare" role="tabpanel">
        <div class="code-snippet-box">
          <code>curl -fsSL https://raw.githubusercontent.com/miftahganzz/Pulse/main/agent/pulse-agent/scripts/setup-cloudflare.sh | sudo bash</code>
          <button 
            type="button" 
            class="btn-copy" 
            onclick="window.copySnippet('curl -fsSL https://raw.githubusercontent.com/miftahganzz/Pulse/main/agent/pulse-agent/scripts/setup-cloudflare.sh | sudo bash', this)"
            aria-label="Copy Cloudflare install command"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <span>Copy</span>
          </button>
        </div>
        <div class="step-list">
          <div class="step-item">Deploys an outbound-only Cloudflare quick tunnel. Zero incoming ports required.</div>
          <div class="step-item">Provides a secure <code>trycloudflare.com</code> URL or your custom domain name.</div>
          <div class="step-item">Automatic keepalive, SSL termination, and DDoS protection at Cloudflare edge.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Specs Table Section -->
  <section class="section" id="architecture">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Architecture</span>
        <h2>Purpose-built for efficiency & security.</h2>
        <p>No bulky runtime environments. High performance with minimal memory consumption.</p>
      </div>

      <div class="specs-table-box">
        <div class="spec-row">
          <span class="spec-key">macOS Client</span>
          <span class="spec-val">Native Swift 6, SwiftUI, Menu Bar Extra, Sparkle 2 updater, Keychain token security</span>
        </div>
        <div class="spec-row">
          <span class="spec-key">Linux Agent</span>
          <span class="spec-val">Go 1.22 compiled static binary (~7 MB file size, ~15 MB RAM consumption, 0% idle CPU)</span>
        </div>
        <div class="spec-row">
          <span class="spec-key">Transport Layer</span>
          <span class="spec-val">TLS 1.3 / WebSocket connection with active keepalive pings and auto-reconnect</span>
        </div>
        <div class="spec-row">
          <span class="spec-key">Pairing Security</span>
          <span class="spec-val">XXX-XXX code (10-min TTL), 5-attempt rate limiter lockout, TOFU TLS certificate pinning</span>
        </div>
        <div class="spec-row">
          <span class="spec-key">Compatibility</span>
          <span class="spec-val">macOS 13.0+ (Ventura, Sonoma, Sequoia) • Linux kernel 4.4+ (x86_64, arm64)</span>
        </div>
        <div class="spec-row">
          <span class="spec-key">Telemetry</span>
          <span class="spec-val">Strictly zero. All data stays between your Mac and your server nodes</span>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section" id="faq">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">FAQ</span>
        <h2>Frequently Asked Questions</h2>
        <p>Direct answers regarding privacy, connectivity, and permissions.</p>
      </div>

      <div class="faq-box">
        <div class="faq-item">
          <button type="button" class="faq-question-btn" aria-expanded="false">
            <span>Do my server metrics pass through any third-party cloud server?</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </button>
          <div class="faq-answer">
            <p>No. Pulse operates strictly point-to-point. Your Mac establishes a direct TLS connection to your Linux agent, or through your private Tailscale network or Cloudflare Tunnel. We run zero centralized telemetry servers and collect zero analytical data.</p>
          </div>
        </div>

        <div class="faq-item">
          <button type="button" class="faq-question-btn" aria-expanded="false">
            <span>Can I run the agent without root or sudo permissions?</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </button>
          <div class="faq-answer">
            <p>Yes. Pulse v1.0.2 introduced standalone non-root user mode. The installer places the binary in <code>~/.local/bin</code> and configures a user-level systemd daemon (<code>systemctl --user</code>) or crontab <code>@reboot</code> persistence without asking for root privileges.</p>
          </div>
        </div>

        <div class="faq-item">
          <button type="button" class="faq-question-btn" aria-expanded="false">
            <span>How does the pairing process work?</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </button>
          <div class="faq-answer">
            <p>After installing the agent, run <code>pulse pair</code> on your server. The agent displays a temporary 6-character code (such as <code>607-019</code>) valid for 10 minutes. Enter this code into Pulse on your Mac. The client pins the server's TLS certificate fingerprint (TOFU) and saves the authorization token locally.</p>
          </div>
        </div>

        <div class="faq-item">
          <button type="button" class="faq-question-btn" aria-expanded="false">
            <span>Which Linux distributions are supported?</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </button>
          <div class="faq-answer">
            <p>Any modern Linux distribution with systemd or crontab, including Ubuntu (20.04+), Debian (10+), CentOS/RHEL/Rocky Linux (8+), Fedora, Arch Linux, Alpine Linux, and openSUSE. We provide precompiled binaries for both x86_64 (amd64) and arm64 (aarch64 / Raspberry Pi / Ampere).</p>
          </div>
        </div>

        <div class="faq-item">
          <button type="button" class="faq-question-btn" aria-expanded="false">
            <span>Is Pulse free and open source?</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </button>
          <div class="faq-answer">
            <p>Yes. Pulse is open source under the MIT License on GitHub. Both the macOS client source code and the Linux Go agent source code are available in the repository.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Client-side Scripts for Tabs & FAQ Accordion -->
  <script>
    // App Showcase Preview Tabs
    const showcaseTabs = document.querySelectorAll('.window-tab-btn');
    const showcaseScreens = {
      'screen-dashboard': document.getElementById('screen-dashboard'),
      'screen-security': document.getElementById('screen-security'),
      'screen-welcome': document.getElementById('screen-welcome')
    };

    showcaseTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        showcaseTabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        const target = tab.getAttribute('data-target');
        Object.entries(showcaseScreens).forEach(([id, img]) => {
          if (img) {
            if (id === target) {
              img.classList.remove('hidden');
            } else {
              img.classList.add('hidden');
            }
          }
        });
      });
    });

    // Setup Tabs
    const setupTabs = document.querySelectorAll('.setup-tabs .tab-btn');
    const setupContents = {
      'tab-direct': document.getElementById('tab-direct'),
      'tab-tailscale': document.getElementById('tab-tailscale'),
      'tab-cloudflare': document.getElementById('tab-cloudflare')
    };

    setupTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        setupTabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        const target = tab.getAttribute('data-tab');
        Object.entries(setupContents).forEach(([id, content]) => {
          if (content) {
            if (id === target) {
              content.classList.add('active');
            } else {
              content.classList.remove('active');
            }
          }
        });
      });
    });

    // FAQ Accordion
    const faqItems = document.querySelectorAll('.faq-item');
    faqItems.forEach(item => {
      const btn = item.querySelector('.faq-question-btn');
      if (btn) {
        btn.addEventListener('click', () => {
          const isOpen = item.classList.toggle('open');
          btn.setAttribute('aria-expanded', String(isOpen));
          const icon = btn.querySelector('.faq-icon');
          if (icon) {
            icon.textContent = isOpen ? '−' : '+';
          }
        });
      }
    });
  </script>
</Layout>
