---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Pulse: Native macOS Server and Container Monitor"
  description="Native macOS menu bar and desktop app paired with a lightweight 7MB Go agent to monitor Linux servers, Docker containers, and systemd units."
>
  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <h1 class="hero-title">
        Monitor Linux servers and containers directly from your Mac menu bar.
      </h1>

      <p class="hero-subtitle">
        Point-to-point TLS connection. Real-time CPU, memory, disks, network, Docker container states, and systemd units. No cloud intermediary, no telemetry.
      </p>

      <div class="hero-actions">
        <a href="/downloads" class="btn btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.61-.75 1.04-1.8 1.01-2.87-.96.04-2.13.65-2.79 1.43-.58.67-1.1 1.76-1.02 2.81 1.07.08 2.19-.61 2.8-1.37z"/>
          </svg>
          <span>Download for macOS</span>
        </a>

        <a href="https://github.com/miftahganzz/Pulse" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          <span>GitHub</span>
        </a>
      </div>

      <div class="quick-install-box">
        <div class="quick-install-label">
          <span class="cmd-prefix">Linux agent install:</span>
          <code>curl -fsSL https://raw.githubusercontent.com/miftahganzz/Pulse/main/agent/pulse-agent/scripts/install.sh | sudo bash</code>
        </div>
        <button 
          type="button" 
          class="btn-copy" 
          onclick="window.copySnippet('curl -fsSL https://raw.githubusercontent.com/miftahganzz/Pulse/main/agent/pulse-agent/scripts/install.sh | sudo bash', this)"
          aria-label="Copy installation command"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span>Copy</span>
        </button>
      </div>

      <!-- Hero Interface Preview -->
      <div class="hero-preview">
        <div class="screenshot-frame">
          <img 
            src="/images/pulse-server-detail.png" 
            alt="Pulse native macOS desktop client showing live server telemetry, masked IP, container vitals, and agent OTA update banner" 
            width="1040" 
            height="650"
            loading="eager"
          />
          <div class="screenshot-caption">
            <span>Server detail view: live telemetry streaming, masked IP addresses, systemd & container controls, and 1-click Agent OTA upgrades.</span>
            <div class="caption-tags">
              <span class="caption-tag">SwiftUI</span>
              <span class="caption-tag">Go Daemon</span>
              <span class="caption-tag">Encrypted WSS</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Capabilities Section -->
  <section class="section" id="features">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Capabilities</span>
        <h2>Linux server control in a native desktop client.</h2>
        <p>Pulse connects a native Swift macOS client directly to a Go daemon on your host without web wrappers.</p>
      </div>

      <div class="grid-3">
        <!-- Feature 1 -->
        <div class="card">
          <div class="card-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
            </svg>
          </div>
          <h3 class="card-title">Live Telemetry</h3>
          <p class="card-desc">WebSocket streaming updates every second for CPU load, memory distribution, disk partitions, and network I/O with historical sparklines.</p>
        </div>

        <!-- Feature 2 -->
        <div class="card">
          <div class="card-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
              <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
          </div>
          <h3 class="card-title">Docker Containers</h3>
          <p class="card-desc">Inspect container states, memory usage, and port mappings. Restart, stop, or stream container stdout and stderr in real time.</p>
        </div>

        <!-- Feature 3 -->
        <div class="card">
          <div class="card-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
              <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
              <line x1="6" y1="6" x2="6.01" y2="6"></line>
              <line x1="6" y1="18" x2="6.01" y2="18"></line>
            </svg>
          </div>
          <h3 class="card-title">Systemd Units</h3>
          <p class="card-desc">Monitor background services (Nginx, PostgreSQL, Caddy, custom units). Inspect journalctl logs, reload configs, and manage daemons.</p>
        </div>

        <!-- Feature 4 -->
        <div class="card">
          <div class="card-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3 class="card-title">Port Auditor</h3>
          <p class="card-desc">Socket inspection detects open TCP listening ports, identifies public 0.0.0.0 bindings, and checks UFW or firewalld rules.</p>
        </div>

        <!-- Feature 5 -->
        <div class="card">
          <div class="card-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <h3 class="card-title">Zero Cloud Relay</h3>
          <p class="card-desc">Encrypted point-to-point connection. Connect via LAN, public IP, Tailscale private mesh, or Cloudflare Tunnel with zero open inbound ports.</p>
        </div>

        <!-- Feature 6 -->
        <div class="card">
          <div class="card-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          </div>
          <h3 class="card-title">Maintenance Runbooks</h3>
          <p class="card-desc">Single-action commands to vacuum system journals, prune unused Docker images, flush local DNS caches, and inspect disk space.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Interface Showcase Carousel Section -->
  <section class="section" id="interface">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Interface & Workflow</span>
        <h2>Designed for operators. Native, responsive, zero-friction.</h2>
        <p>A fast, fluid interface built with macOS design principles. No electron bloat, no clunky browser tabs, instant keyboard navigation.</p>
      </div>

      <div class="carousel-container" role="region" aria-roledescription="carousel" aria-label="Pulse Interface Showcase">
        <!-- Slide Navigation Tabs (Top) -->
        <div class="carousel-nav" role="tablist">
          <button type="button" class="carousel-tab active" data-slide="0" role="tab" aria-selected="true" aria-controls="slide-0">
            <span>Fleet Overview</span>
          </button>
          <button type="button" class="carousel-tab" data-slide="1" role="tab" aria-selected="false" aria-controls="slide-1">
            <span>Live Logs</span>
          </button>
          <button type="button" class="carousel-tab" data-slide="2" role="tab" aria-selected="false" aria-controls="slide-2">
            <span>Process Manager</span>
          </button>
          <button type="button" class="carousel-tab" data-slide="3" role="tab" aria-selected="false" aria-controls="slide-3">
            <span>Storage & Cleaners</span>
          </button>
          <button type="button" class="carousel-tab" data-slide="4" role="tab" aria-selected="false" aria-controls="slide-4">
            <span>Maintenance Runbooks</span>
          </button>
          <button type="button" class="carousel-tab" data-slide="5" role="tab" aria-selected="false" aria-controls="slide-5">
            <span>Menu Bar Extra</span>
          </button>
          <button type="button" class="carousel-tab" data-slide="6" role="tab" aria-selected="false" aria-controls="slide-6">
            <span>Compare Matrix</span>
          </button>
          <button type="button" class="carousel-tab" data-slide="7" role="tab" aria-selected="false" aria-controls="slide-7">
            <span>Add Server Modal</span>
          </button>
        </div>

        <!-- Carousel Track / Slides Viewport -->
        <div class="carousel-viewport">
          <!-- Slide 0: Fleet Overview -->
          <div class="carousel-slide active" id="slide-0" role="tabpanel" aria-label="1 of 8: Fleet Overview">
            <div class="slide-media">
              <img 
                src="/images/pulse-fleet-overview.png" 
                alt="Pulse fleet overview showing all connected servers with masked IPs and health badges" 
                width="1040" 
                height="650"
                loading="lazy"
              />
            </div>
            <div class="slide-caption">
              <div class="caption-text">
                <h3>Fleet-Wide Multi-Server Overview</h3>
                <p>Unified pane of glass for bare-metal, VPS, and cloud nodes with aggregate metrics, health badges, and one-click IP address privacy masking.</p>
              </div>
              <div class="caption-tags">
                <span class="caption-tag">All Servers</span>
                <span class="caption-tag">Privacy Mask</span>
                <span class="caption-tag">Health Badges</span>
              </div>
            </div>
          </div>

          <!-- Slide 1: Live Logs -->
          <div class="carousel-slide" id="slide-1" role="tabpanel" aria-label="2 of 8: Live Logs">
            <div class="slide-media">
              <img 
                src="/images/pulse-live-logs.png" 
                alt="Sub-second WebSocket live log streaming for systemd journal and Docker containers" 
                width="1040" 
                height="650"
                loading="lazy"
              />
            </div>
            <div class="slide-caption">
              <div class="caption-text">
                <h3>Sub-Second Live Log Streaming</h3>
                <p>Stream systemd service logs and Docker container stdout/stderr directly over encrypted WebSockets without SSH sessions or terminal windows.</p>
              </div>
              <div class="caption-tags">
                <span class="caption-tag">journalctl -u</span>
                <span class="caption-tag">Docker stdout</span>
                <span class="caption-tag">Keyword Search</span>
              </div>
            </div>
          </div>

          <!-- Slide 2: Process Manager -->
          <div class="carousel-slide" id="slide-2" role="tabpanel" aria-label="3 of 8: Process Manager">
            <div class="slide-media">
              <img 
                src="/images/pulse-processes.png" 
                alt="Linux process manager with live CPU, memory, and disk I/O metrics" 
                width="1040" 
                height="650"
                loading="lazy"
              />
            </div>
            <div class="slide-caption">
              <div class="caption-text">
                <h3>Process Manager & Resource Auditing</h3>
                <p>Real-time PID inspection sorted by CPU, memory, and disk throughput directly from Linux /proc. Kill rogue processes with safe confirmation.</p>
              </div>
              <div class="caption-tags">
                <span class="caption-tag">/proc/[pid]/io</span>
                <span class="caption-tag">Memory & CPU</span>
                <span class="caption-tag">SIGTERM / SIGKILL</span>
              </div>
            </div>
          </div>

          <!-- Slide 3: Storage & Cleaners -->
          <div class="carousel-slide" id="slide-3" role="tabpanel" aria-label="4 of 8: Storage & Cleaners">
            <div class="slide-media">
              <img 
                src="/images/pulse-disk-analyzer.png" 
                alt="Disk space breakdown and safe reclamation cleaners" 
                width="1040" 
                height="650"
                loading="lazy"
              />
            </div>
            <div class="slide-caption">
              <div class="caption-text">
                <h3>Disk Storage Analyzer & 1-Click Cleaners</h3>
                <p>Instant directory consumption breakdown for /var/log, Docker, and system caches with safe reclamation tools (vacuum journals, prune Docker, clean APT).</p>
              </div>
              <div class="caption-tags">
                <span class="caption-tag">Safe Cleaners</span>
                <span class="caption-tag">Docker Prune</span>
                <span class="caption-tag">Journal Vacuum</span>
              </div>
            </div>
          </div>

          <!-- Slide 4: Runbooks -->
          <div class="carousel-slide" id="slide-4" role="tabpanel" aria-label="5 of 8: Maintenance Runbooks">
            <div class="slide-media">
              <img 
                src="/images/pulse-runbooks.png" 
                alt="Maintenance runbooks modal for pre-approved sysadmin operational actions" 
                width="1040" 
                height="650"
                loading="lazy"
              />
            </div>
            <div class="slide-caption">
              <div class="caption-text">
                <h3>Operational Maintenance Runbooks (⌘R)</h3>
                <p>Trigger pre-approved sysadmin tasks directly from macOS: gracefully reload webservers, flush DNS resolver caches, test updates, or free memory pagecache.</p>
              </div>
              <div class="caption-tags">
                <span class="caption-tag">⌘R Runbooks</span>
                <span class="caption-tag">Webserver Reload</span>
                <span class="caption-tag">DNS Flush</span>
              </div>
            </div>
          </div>

          <!-- Slide 5: Menu Bar Extra -->
          <div class="carousel-slide" id="slide-5" role="tabpanel" aria-label="6 of 8: Menu Bar Extra">
            <div class="slide-media">
              <img 
                src="/images/pulse-menu-bar.png" 
                alt="Native macOS menu bar status popover showing active incidents and server status" 
                width="1040" 
                height="650"
                loading="lazy"
              />
            </div>
            <div class="slide-caption">
              <div class="caption-text">
                <h3>Native macOS Menu Bar Status Popover</h3>
                <p>Lightweight status bar item providing immediate awareness of node connectivity, server health vitals, active incidents, and quick reconnect controls.</p>
              </div>
              <div class="caption-tags">
                <span class="caption-tag">Menu Bar Extra</span>
                <span class="caption-tag">Active Incidents</span>
                <span class="caption-tag">⌘O / ⇧⌘R</span>
              </div>
            </div>
          </div>

          <!-- Slide 6: Compare Servers -->
          <div class="carousel-slide" id="slide-6" role="tabpanel" aria-label="7 of 8: Compare Servers">
            <div class="slide-media">
              <img 
                src="/images/pulse-compare-servers.png" 
                alt="Side-by-side server performance comparison matrix" 
                width="1040" 
                height="650"
                loading="lazy"
              />
            </div>
            <div class="slide-caption">
              <div class="caption-text">
                <h3>Side-by-Side Comparison Matrix</h3>
                <p>Compare real-time CPU spikes, memory saturation, load averages, and network throughput side-by-side across staging and production clusters.</p>
              </div>
              <div class="caption-tags">
                <span class="caption-tag">Benchmarking</span>
                <span class="caption-tag">Multi-Node</span>
                <span class="caption-tag">Cluster Vitals</span>
              </div>
            </div>
          </div>

          <!-- Slide 7: Add Server Modal -->
          <div class="carousel-slide" id="slide-7" role="tabpanel" aria-label="8 of 8: Add Server Modal">
            <div class="slide-media">
              <img 
                src="/images/pulse-add-server.png" 
                alt="Pulse Add Linux VPS onboarding modal" 
                width="1040" 
                height="650"
                loading="lazy"
              />
            </div>
            <div class="slide-caption">
              <div class="caption-text">
                <h3>Frictionless Server Onboarding</h3>
                <p>Connect servers in seconds with 1-line curl commands, temporary pairing codes, native Tailscale mesh discovery, or Cloudflare Tunnels.</p>
              </div>
              <div class="caption-tags">
                <span class="caption-tag">1-Line Setup</span>
                <span class="caption-tag">Tailscale</span>
                <span class="caption-tag">Non-Root</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Carousel Controls (Prev, Next, Counter) -->
        <div class="carousel-footer">
          <div class="carousel-arrows">
            <button type="button" class="btn-carousel-ctrl prev" id="carousel-prev" aria-label="Previous screenshot">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button type="button" class="btn-carousel-ctrl next" id="carousel-next" aria-label="Next screenshot">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>
          <div class="carousel-counter" aria-live="polite">
            <span id="carousel-current">1</span> / <span id="carousel-total">8</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Setup Section -->
  <section class="section" id="setup">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Installation</span>
        <h2>One command to install. Select your network topology.</h2>
        <p>Supports Debian, Ubuntu, RHEL, CentOS, Fedora, Arch, Alpine, openSUSE, and any systemd Linux. Available in root and non-root user modes.</p>
      </div>

      <div class="setup-tabs" role="tablist">
        <button type="button" class="tab-btn active" data-tab="tab-direct" role="tab" aria-selected="true">
          <span>Direct IP / LAN</span>
        </button>
        <button type="button" class="tab-btn" data-tab="tab-tailscale" role="tab" aria-selected="false">
          <span>Tailscale (Zero Open Ports)</span>
        </button>
        <button type="button" class="tab-btn" data-tab="tab-cloudflare" role="tab" aria-selected="false">
          <span>Cloudflare Tunnel (Zero Open Ports)</span>
        </button>
      </div>

      <!-- Tab 1: Direct IP -->
      <div class="tab-content active" id="tab-direct" role="tabpanel">
        <div class="code-snippet-box">
          <code>curl -fsSL https://raw.githubusercontent.com/miftahganzz/Pulse/main/agent/pulse-agent/scripts/install.sh | sudo bash</code>
          <button 
            type="button" 
            class="btn-copy" 
            onclick="window.copySnippet('curl -fsSL https://raw.githubusercontent.com/miftahganzz/Pulse/main/agent/pulse-agent/scripts/install.sh | sudo bash', this)"
            aria-label="Copy Direct IP install command"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <span>Copy</span>
          </button>
        </div>
        <div class="step-list">
          <div class="step-item">Downloads static binary for your architecture (x86_64 or arm64).</div>
          <div class="step-item">Generates TLS certificates and configures systemd service.</div>
          <div class="step-item">Adjusts firewall (UFW, firewalld, iptables) for port 9876.</div>
          <div class="step-item">Generates temporary pairing code valid for 10 minutes.</div>
        </div>
      </div>

      <!-- Tab 2: Tailscale -->
      <div class="tab-content" id="tab-tailscale" role="tabpanel">
        <div class="code-snippet-box">
          <code>curl -fsSL https://raw.githubusercontent.com/miftahganzz/Pulse/main/agent/pulse-agent/scripts/setup-tailscale.sh | sudo bash</code>
          <button 
            type="button" 
            class="btn-copy" 
            onclick="window.copySnippet('curl -fsSL https://raw.githubusercontent.com/miftahganzz/Pulse/main/agent/pulse-agent/scripts/setup-tailscale.sh | sudo bash', this)"
            aria-label="Copy Tailscale install command"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <span>Copy</span>
          </button>
        </div>
        <div class="step-list">
          <div class="step-item">Binds Pulse exclusively to the host Tailscale interface (100.x.y.z).</div>
          <div class="step-item">No public ports are opened. Accessible only by devices in your private Tailnet.</div>
          <div class="step-item">Encrypted WireGuard transport with automatic roaming.</div>
        </div>
      </div>

      <!-- Tab 3: Cloudflare Tunnel -->
      <div class="tab-content" id="tab-cloudflare" role="tabpanel">
        <div class="code-snippet-box">
          <code>curl -fsSL https://raw.githubusercontent.com/miftahganzz/Pulse/main/agent/pulse-agent/scripts/setup-cloudflare.sh | sudo bash</code>
          <button 
            type="button" 
            class="btn-copy" 
            onclick="window.copySnippet('curl -fsSL https://raw.githubusercontent.com/miftahganzz/Pulse/main/agent/pulse-agent/scripts/setup-cloudflare.sh | sudo bash', this)"
            aria-label="Copy Cloudflare install command"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <span>Copy</span>
          </button>
        </div>
        <div class="step-list">
          <div class="step-item">Establishes an outbound-only Cloudflare quick tunnel without opening incoming ports.</div>
          <div class="step-item">Provides a trycloudflare.com URL or your configured domain.</div>
          <div class="step-item">Persistent keepalive and edge SSL termination.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Specs Table Section -->
  <section class="section" id="architecture">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Specifications</span>
        <h2>Architecture details</h2>
        <p>Resource footprints and operational characteristics.</p>
      </div>

      <div class="specs-table-box">
        <div class="spec-row">
          <span class="spec-key">macOS Client</span>
          <span class="spec-val">Native Swift 6, SwiftUI, Menu Bar Extra, Sparkle 2 updater, local Keychain storage</span>
        </div>
        <div class="spec-row">
          <span class="spec-key">Linux Agent</span>
          <span class="spec-val">Static Go binary (~7 MB file size, ~15 MB RAM usage, 0% idle CPU)</span>
        </div>
        <div class="spec-row">
          <span class="spec-key">Transport</span>
          <span class="spec-val">TLS 1.3 / WebSocket with active keepalive ping and auto-reconnect</span>
        </div>
        <div class="spec-row">
          <span class="spec-key">Pairing Security</span>
          <span class="spec-val">Temporary code (10-min TTL), rate-limiter lockout, TOFU certificate pinning</span>
        </div>
        <div class="spec-row">
          <span class="spec-key">Compatibility</span>
          <span class="spec-val">macOS 13.0+ (Ventura, Sonoma, Sequoia), Linux kernel 4.4+ (x86_64, arm64)</span>
        </div>
        <div class="spec-row">
          <span class="spec-key">Telemetry</span>
          <span class="spec-val">Zero. All metrics remain on your own machines</span>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section" id="faq">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Questions</span>
        <h2>Frequently asked questions</h2>
        <p>Specific details on security, networking, and installation.</p>
      </div>

      <div class="faq-box">
        <div class="faq-item">
          <button type="button" class="faq-question-btn" aria-expanded="false">
            <span>Do metrics pass through any third-party servers?</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </button>
          <div class="faq-answer">
            <p>No. Communication is strictly point-to-point. Your Mac connects directly to the agent over TLS, or through your own Tailscale or Cloudflare tunnel. We operate zero cloud relays and collect zero analytical telemetry.</p>
          </div>
        </div>

        <div class="faq-item">
          <button type="button" class="faq-question-btn" aria-expanded="false">
            <span>Can the agent run without root privileges?</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </button>
          <div class="faq-answer">
            <p>Yes. Standalone non-root user mode installs the binary to ~/.local/bin and configures a user-level systemd service (systemctl --user) or crontab @reboot persistence without sudo.</p>
          </div>
        </div>

        <div class="faq-item">
          <button type="button" class="faq-question-btn" aria-expanded="false">
            <span>How does initial pairing work?</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </button>
          <div class="faq-answer">
            <p>Running "pulse pair" on the server displays a temporary 6-character code that expires in 10 minutes. Enter this code into Pulse on macOS. The app pins the server TLS certificate fingerprint and stores the authentication token locally.</p>
          </div>
        </div>

        <div class="faq-item">
          <button type="button" class="faq-question-btn" aria-expanded="false">
            <span>What Linux distributions are supported?</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </button>
          <div class="faq-answer">
            <p>Any modern Linux distribution with systemd or crontab, including Ubuntu, Debian, CentOS, RHEL, Rocky Linux, Fedora, Arch Linux, Alpine Linux, and openSUSE on x86_64 and arm64 architectures.</p>
          </div>
        </div>

        <div class="faq-item">
          <button type="button" class="faq-question-btn" aria-expanded="false">
            <span>Is Pulse open source?</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </button>
          <div class="faq-answer">
            <p>Yes. Both the macOS application and Linux agent source code are licensed under the MIT License on GitHub.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Client-side Scripts for Setup Tabs & FAQ Accordion -->
  <script>
    // Setup Tabs
    const setupTabs = document.querySelectorAll('.setup-tabs .tab-btn');
    const setupContents: Record<string, HTMLElement | null> = {
      'tab-direct': document.getElementById('tab-direct'),
      'tab-tailscale': document.getElementById('tab-tailscale'),
      'tab-cloudflare': document.getElementById('tab-cloudflare')
    };

    setupTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        setupTabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        const target = tab.getAttribute('data-tab');
        if (!target) return;
        Object.entries(setupContents).forEach(([id, content]) => {
          if (content) {
            if (id === target) {
              content.classList.add('active');
            } else {
              content.classList.remove('active');
            }
          }
        });
      });
    });

    // FAQ Accordion
    const faqItems = document.querySelectorAll('.faq-item');
    faqItems.forEach(item => {
      const btn = item.querySelector('.faq-question-btn');
      if (btn) {
        btn.addEventListener('click', () => {
          const isOpen = item.classList.toggle('open');
          btn.setAttribute('aria-expanded', String(isOpen));
          const icon = btn.querySelector('.faq-icon');
          if (icon) {
            icon.textContent = isOpen ? '−' : '+';
          }
        });
      }
    });

    // Interface Showcase Carousel Logic (Antislop UI)
    const carouselTabs = document.querySelectorAll('.carousel-tab');
    const carouselSlides = document.querySelectorAll('.carousel-slide');
    const carouselPrev = document.getElementById('carousel-prev');
    const carouselNext = document.getElementById('carousel-next');
    const carouselCurrent = document.getElementById('carousel-current');
    const carouselTotal = document.getElementById('carousel-total');

    let currentIndex = 0;
    const totalSlides = carouselSlides.length;
    if (carouselTotal) {
      carouselTotal.textContent = String(totalSlides);
    }

    function goToSlide(index: number) {
      if (index < 0) {
        index = totalSlides - 1;
      } else if (index >= totalSlides) {
        index = 0;
      }
      currentIndex = index;

      // Update tabs
      carouselTabs.forEach((tab, i) => {
        const isActive = i === currentIndex;
        tab.classList.toggle('active', isActive);
        tab.setAttribute('aria-selected', String(isActive));
        if (isActive) {
          tab.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
      });

      // Update slides
      carouselSlides.forEach((slide, i) => {
        slide.classList.toggle('active', i === currentIndex);
      });

      // Update counter
      if (carouselCurrent) {
        carouselCurrent.textContent = String(currentIndex + 1);
      }
    }

    carouselTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const slideIdx = parseInt(tab.getAttribute('data-slide') || '0', 10);
        goToSlide(slideIdx);
      });
    });

    if (carouselPrev) {
      carouselPrev.addEventListener('click', () => goToSlide(currentIndex - 1));
    }
    if (carouselNext) {
      carouselNext.addEventListener('click', () => goToSlide(currentIndex + 1));
    }

    // Keyboard navigation when carousel is focused
    const carouselRegion = document.querySelector('.carousel-container');
    if (carouselRegion) {
      carouselRegion.addEventListener('keydown', (e: Event) => {
        const keyEvent = e as KeyboardEvent;
        if (keyEvent.key === 'ArrowLeft') {
          goToSlide(currentIndex - 1);
        } else if (keyEvent.key === 'ArrowRight') {
          goToSlide(currentIndex + 1);
        }
      });
    }

    // Touch swipe support for mobile
    let touchStartX = 0;
    let touchEndX = 0;
    const viewport = document.querySelector('.carousel-viewport');
    if (viewport) {
      viewport.addEventListener('touchstart', (e: Event) => {
        const touchEvent = e as TouchEvent;
        touchStartX = touchEvent.changedTouches[0].screenX;
      }, { passive: true });

      viewport.addEventListener('touchend', (e: Event) => {
        const touchEvent = e as TouchEvent;
        touchEndX = touchEvent.changedTouches[0].screenX;
        if (touchStartX - touchEndX > 50) {
          goToSlide(currentIndex + 1);
        } else if (touchEndX - touchStartX > 50) {
          goToSlide(currentIndex - 1);
        }
      }, { passive: true });
    }
  </script>
</Layout>
