---
import Layout from '../layouts/Layout.astro';

const releases = [
  {
    version: "v1.0.5",
    build: "Build 105",
    date: "September 13, 2026",
    isLatest: true,
    highlights: [
      {
        title: "Resilient Persistent Connections and Keepalive",
        desc: "Added periodic WebSocket pings from client to agent, extended agent write deadlines to 25s, increased client heartbeat timeout tolerance to 30s, and streamlined direct WebSocket connections to prevent dropouts across NATs, firewalls, Cloudflare tunnels, and macOS sleep/wake cycles."
      },
      {
        title: "Eliminated Keychain Password Prompts",
        desc: "Replaced repeated macOS Keychain prompts on launch with in-memory fast caching and local persistent storage for server tokens, database credentials, and TLS fingerprints."
      },
      {
        title: "Docker Detection and Null Ports Decoding Fix",
        desc: "Fixed an issue where containers without exposed public ports (e.g. Supabase, private network containers) returning null port arrays caused JSON decoding failures and falsely triggered 'Docker Not Detected'."
      },
      {
        title: "Resilient Container Decoding",
        desc: "The macOS client now gracefully decodes null or missing container metadata fields across Docker engine variants."
      },
      {
        title: "Docker Error State and Retry",
        desc: "Added dedicated failure cards with an actionable retry button when container retrieval encounters network or decode issues."
      },
      {
        title: "Agent Auto-Update Release Binaries",
        desc: "Restored standalone linux/amd64 and linux/arm64 release binary assets on GitHub Releases for in-place updates via 'pulse update'."
      }
    ]
  },
  {
    version: "v1.0.4",
    build: "Build 104",
    date: "September 13, 2026",
    isLatest: false,
    highlights: [
      {
        title: "Brute-Force and Port Scanning Defense",
        desc: "Sliding-window rate limiter on the agent that automatically blocks malicious IPs for 15 minutes after repeated failed authentication or pairing attempts."
      },
      {
        title: "Pairing Session Brute-Force Lockout",
        desc: "Immediate revocation and purge of pairing sessions after 5 invalid code attempts."
      },
      {
        title: "CSWSH and HTTP Security Headers",
        desc: "Strict Cross-Site WebSocket Hijacking origin verification, plus hardened HTTP security headers (CSP, HSTS, X-Frame-Options, nosniff)."
      },
      {
        title: "Tamper-Resistant Action Audit Trail",
        desc: "Linux agent records all executed actions, scripts, and runbooks with timestamp, user identity, and status to an append-only audit log."
      },
      {
        title: "TOFU TLS Certificate Pinning",
        desc: "The macOS app pins server TLS certificate fingerprints on first connect and alerts immediately if a certificate changes or is intercepted."
      },
      {
        title: "Biometric Security Gate (Touch ID)",
        desc: "Optional Touch ID, Apple Watch, or Mac password confirmation before running destructive actions (reboot, service restart, container termination)."
      }
    ]
  },
  {
    version: "v1.0.3",
    build: "Build 103",
    date: "September 13, 2026",
    isLatest: false,
    highlights: [
      {
        title: "Add Server Screen Redesign",
        desc: "Direct method selection (Direct IP, Cloudflare Tunnel, Tailscale) and mode selection (Root vs. Non-Root) on the primary screen."
      },
      {
        title: "Inline Setup Snippet",
        desc: "Instant copy button for 1-line setup command with helper badges and server connection fields in one view."
      },
      {
        title: "Universal Non-Root Support",
        desc: "Dedicated non-root options for Direct IP, Tailscale, and Cloudflare Tunnel."
      }
    ]
  },
  {
    version: "v1.0.2",
    build: "Build 102",
    date: "September 13, 2026",
    isLatest: false,
    highlights: [
      {
        title: "Non-Root User Mode",
        desc: "Standalone support for non-root VPS accounts and shared environments. Installs to ~/.local/bin and ~/.pulse without requiring sudo."
      },
      {
        title: "Cloudflare and Tailscale Non-Root",
        desc: "Dedicated one-line non-root scripts without requiring root or open ports."
      },
      {
        title: "User-Level Systemd and Crontab Fallback",
        desc: "Deploys daemon via systemctl --user with auto-linger or crontab @reboot persistence."
      }
    ]
  },
  {
    version: "v1.0.1",
    build: "Build 11",
    date: "September 12, 2026",
    isLatest: false,
    highlights: [
      {
        title: "Unified Pulse CLI",
        desc: "Command line tool (pulse) on Linux nodes for status, pairing, Tailscale, Cloudflare tunnels, logs, and self-updates."
      },
      {
        title: "Network Offline Auto-Reconnect",
        desc: "Real-time network monitor that detects Wi-Fi or Ethernet drops and reconnects servers automatically when online."
      },
      {
        title: "Live Log Streaming Enhancements",
        desc: "Connection-state aware WebSocket log streamer with automatic retry and idle indicators."
      }
    ]
  },
  {
    version: "v1.0.0",
    build: "Build 10",
    date: "September 12, 2026",
    isLatest: false,
    highlights: [
      {
        title: "Live Log Viewer and Streaming (Cmd+L)",
        desc: "Real-time WebSocket log streaming for Systemd services and Docker containers with regex search, pause, and auto-scroll."
      },
      {
        title: "Outbound Telegram Alerts",
        desc: "Direct Bot API push notifications to user IDs and ops channels with test alert and flapping protection."
      },
      {
        title: "Disk Space Analyzer (Cmd+U)",
        desc: "Breakdown of disk usage across /var/log, Docker, cache, and safe cleaners (vacuum journals, docker prune, clean apt)."
      },
      {
        title: "Maintenance Runbooks (Cmd+R)",
        desc: "Execution shortcuts for reloading web servers (Nginx, Caddy), flushing DNS cache, and checking OS updates."
      },
      {
        title: "Process Network and Disk I/O",
        desc: "Real-time read and write throughput and open socket file descriptor audit in the Process table."
      }
    ]
  },
  {
    version: "v0.9.0",
    build: "Build 9",
    date: "September 12, 2026",
    isLatest: false,
    highlights: [
      {
        title: "Server Tags and Environments",
        desc: "Group servers in the sidebar by Production, Staging, Development, and Other."
      },
      {
        title: "One-Command Automated Setup",
        desc: "Automated scripts for Direct IP, Tailscale, and Cloudflare Tunnel with auto-detection of firewall and CPU architecture."
      },
      {
        title: "Human-Friendly Pairing Code",
        desc: "XXX-XXX format code (e.g. 607-019) with 10-minute validity."
      }
    ]
  },
  {
    version: "v0.8.0",
    build: "Build 8",
    date: "September 11, 2026",
    isLatest: false,
    highlights: [
      {
        title: "Security and Open Ports Inspector",
        desc: "Real-time socket audit, exposure detection, and UFW firewall checks."
      },
      {
        title: "Sparkle 2 Auto-Updater",
        desc: "Background and on-demand app updates with Ed25519 signatures."
      },
      {
        title: "Custom URL Scheme",
        desc: "Supported pulse://add deep linking for server onboarding."
      }
    ]
  }
];
---

<Layout 
  title="Changelog: Pulse Release History"
  description="Chronological release history and update notes for the Pulse macOS client and Linux agent."
>
  <div class="page-header">
    <div class="container">
      <h1 class="page-title">Changelog</h1>
      <p class="page-subtitle">Release notes and chronological updates for Pulse.</p>
    </div>
  </div>

  <section class="section" style="padding-top: 0;">
    <div class="container" style="max-width: 800px;">
      {releases.map((rel) => (
        <article class="changelog-entry">
          <div class="changelog-header">
            <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
              <h2 class="changelog-version">{rel.version}</h2>
              {rel.isLatest && <span class="changelog-badge">Latest</span>}
              <span style="font-size: 0.8rem; color: var(--text-muted); font-family: var(--font-mono);">{rel.build}</span>
            </div>
            <time class="changelog-date">{rel.date}</time>
          </div>

          <ul class="changelog-content">
            {rel.highlights.map((h) => (
              <li>
                <strong>{h.title}:</strong> {h.desc}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>
</Layout>
