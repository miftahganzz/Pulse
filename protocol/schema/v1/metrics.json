{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MetricsSnapshotPayload",
  "type": "object",
  "required": [
    "timestamp",
    "cpu",
    "memory",
    "disks",
    "network",
    "load_avg",
    "uptime_seconds"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "cpu": {
      "type": "object",
      "required": ["usage_percent", "user_percent", "system_percent", "idle_percent", "steal_percent", "cores"],
      "properties": {
        "usage_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "user_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "system_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "idle_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "steal_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "cores": { "type": "integer", "minimum": 1 }
      }
    },
    "memory": {
      "type": "object",
      "required": ["total_bytes", "used_bytes", "available_bytes", "free_bytes", "usage_percent", "swap_total_bytes", "swap_used_bytes"],
      "properties": {
        "total_bytes": { "type": "integer", "minimum": 0 },
        "used_bytes": { "type": "integer", "minimum": 0 },
        "available_bytes": { "type": "integer", "minimum": 0 },
        "free_bytes": { "type": "integer", "minimum": 0 },
        "usage_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "swap_total_bytes": { "type": "integer", "minimum": 0 },
        "swap_used_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "disks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["mount_point", "filesystem", "total_bytes", "used_bytes", "free_bytes", "usage_percent"],
        "properties": {
          "mount_point": { "type": "string" },
          "filesystem": { "type": "string" },
          "total_bytes": { "type": "integer", "minimum": 0 },
          "used_bytes": { "type": "integer", "minimum": 0 },
          "free_bytes": { "type": "integer", "minimum": 0 },
          "usage_percent": { "type": "number", "minimum": 0, "maximum": 100 },
          "read_bytes_per_sec": { "type": "number" },
          "write_bytes_per_sec": { "type": "number" }
        }
      }
    },
    "network": {
      "type": "object",
      "required": ["rx_bytes_per_sec", "tx_bytes_per_sec", "total_rx_bytes", "total_tx_bytes"],
      "properties": {
        "rx_bytes_per_sec": { "type": "number", "minimum": 0 },
        "tx_bytes_per_sec": { "type": "number", "minimum": 0 },
        "total_rx_bytes": { "type": "integer", "minimum": 0 },
        "total_tx_bytes": { "type": "integer", "minimum": 0 },
        "rx_packets_per_sec": { "type": "number" },
        "tx_packets_per_sec": { "type": "number" },
        "errors": { "type": "integer", "minimum": 0 }
      }
    },
    "load_avg": {
      "type": "object",
      "required": ["load1", "load5", "load15"],
      "properties": {
        "load1": { "type": "number", "minimum": 0 },
        "load5": { "type": "number", "minimum": 0 },
        "load15": { "type": "number", "minimum": 0 }
      }
    },
    "uptime_seconds": {
      "type": "integer",
      "minimum": 0
    }
  }
}
